{
  "name": "gmail-manager",
  "version": "0.2.0",
  "description": "Настольное приложение для работы с аккаунтами Gmail через отдельные профили Chrome: сбор лидов, рассылка первых писем и автоответчик.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "electron scripts/make-icon.js",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "author": "Nikita",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "com.gmailmanager.app",
    "productName": "Gmail Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "data/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/playwright-core/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Gmail-Manager-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Gmail-Manager-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bridznostpy",
        "repo": "gmail-manager"
      }
    ]
  }
}
